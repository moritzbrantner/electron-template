{
  "name": "electron-template",
  "productName": "desktop",
  "version": "1.0.0",
  "description": "Reusable Electron desktop template with typed main/preload packages and app-level examples.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "bun": "1.3.x"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "sync:monorepo": "node ./scripts/dispatch-monorepo-update.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "dev": "electron-forge start",
    "build": "bun run build:packages && bun run build:app",
    "build:app": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "build:packages": "bun run --filter '@moritzbrantner/*' build",
    "ci": "bun run lint && bun run build && bun run test:unit && bun run test:integration && bun run test:e2e",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun test ./tests/unit.test.js ./tests/packages/*.test.mts",
    "test:integration": "bun test ./tests/integration.test.js",
    "test:e2e": "bun run build && bunx --bun playwright test",
    "test:package": "./scripts/run-node.sh ./scripts/verify-package.mjs"
  },
  "keywords": [],
  "author": "Moritz Brantner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/electron-template.git"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.58.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "40.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "playwright": "^1.58.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@moritzbrantner/electron-commands": "workspace:*",
    "@moritzbrantner/electron-documents": "workspace:*",
    "@moritzbrantner/electron-json-store": "workspace:*",
    "@moritzbrantner/electron-preferences": "workspace:*",
    "@moritzbrantner/ui": "^0.1.0",
    "@moritzbrantner/electron-window-state": "workspace:*",
    "electron-squirrel-startup": "^1.0.1",
    "nanoid": "^5.1.6"
  },
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*"
  ]
}
