{
  "name": "electron-template",
  "productName": "desktop",
  "version": "1.0.0",
  "description": "Reusable Electron desktop template with typed main/preload packages and app-level examples.",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "bun": "1.3.x"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "dev": "electron-forge start",
    "build": "bun run build:packages && bun run build:app",
    "build:app": "vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts && vite build --config vite.renderer.config.ts",
    "build:packages": "bun run --filter '@moritzbrantner/*' build",
    "ci": "bun run lint && bun run build && bun run test:unit && bun run test:integration && bun run test:package && bun run test:e2e",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun test ./tests/unit.test.js ./tests/packages/*.test.mts",
    "test:integration": "bun test ./tests/integration.test.js",
    "test:e2e": "bun run build && \"$(dirname \"$(command -v npm)\")/node\" ./node_modules/playwright/cli.js test e2e/desktop-smoke.e2e.ts",
    "test:package": "node ./scripts/verify-package.mjs"
  },
  "keywords": [],
  "author": "Moritz Brantner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzbrantner/electron-template.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@moritzbrantner/biome-config-react": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "electron": "41.2.1",
    "playwright": "1.64.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "5.4.21"
  },
  "dependencies": {
    "@moritzbrantner/electron-commands": "workspace:*",
    "@moritzbrantner/electron-documents": "workspace:*",
    "@moritzbrantner/electron-json-store": "workspace:*",
    "@moritzbrantner/electron-preferences": "workspace:*",
    "@moritzbrantner/electron-window-state": "workspace:*",
    "@moritzbrantner/maps": "git+https://github.com/moritzbrantner/maps.git#067636c399f03609ccbd4da27971a02ed6a016a0",
    "@moritzbrantner/timeline-editor": "git+https://github.com/moritzbrantner/timeline-editor.git#9917ede5590e43a9f6ec39e3d420243f060098ac",
    "@moritzbrantner/ui": "git+https://github.com/moritzbrantner/ui.git#9892e374bfd760541b25c4480b5af03e87ee7e9d",
    "electron-squirrel-startup": "^1.0.1",
    "nanoid": "^5.1.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@moritzbrantner/maps",
    "@moritzbrantner/timeline-editor",
    "@moritzbrantner/ui",
    "electron",
    "electron-winstaller",
    "esbuild"
  ]
}
