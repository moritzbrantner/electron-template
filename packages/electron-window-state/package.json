{
  "name": "@moritzbrantner/electron-window-state",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "dependencies": {
    "@moritzbrantner/electron-json-store": "workspace:*"
  },
  "peerDependencies": {
    "electron": ">=40"
  },
  "scripts": {
    "build": "tsup src/main.ts src/shared.ts --format esm --dts --clean"
  },
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "import": "./dist/shared.js"
    }
  }
}
